{
  "info": {
    "_postman_id": "a93e87b0-7d12-4cf4-91b4-2b0c169df301",
    "name": "Document Intelligence & Question Extraction Service",
    "description": "Comprehensive API collection for examination document processing, question segmentation, answer key extraction, and multi-document relationships.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "question_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "answer_key_document_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@pragatibharti.in\",\n  \"password\": \"SecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new user account."
          }
        },
        {
          "name": "1.2 Login (Sets access_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "    pm.environment.set('access_token', jsonData.access_token);",
                  "    console.log('Saved access_token:', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@pragatibharti.in\",\n  \"password\": \"SecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates credentials and stores JWT token in collection variables."
          }
        },
        {
          "name": "1.3 Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Fetches current logged in user details."
          }
        }
      ]
    },
    {
      "name": "2. Document Ingestion",
      "item": [
        {
          "name": "2.1 Upload Clean Exam PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.document_id) {",
                  "    pm.collectionVariables.set('document_id', jsonData.document_id);",
                  "    pm.environment.set('document_id', jsonData.document_id);",
                  "    console.log('Saved document_id:', jsonData.document_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_documents/01_clean_digital_exam.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["documents", "upload"]
            },
            "description": "Uploads PDF examination file and enqueues background processing."
          }
        },
        {
          "name": "2.2 Upload Question Paper Image (PNG)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_documents/02_image_question_paper.png"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["documents", "upload"]
            },
            "description": "Uploads image examination paper for OCR pipeline."
          }
        },
        {
          "name": "2.3 Upload Separate Answer Key PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.document_id) {",
                  "    pm.collectionVariables.set('answer_key_document_id', jsonData.document_id);",
                  "    pm.environment.set('answer_key_document_id', jsonData.document_id);",
                  "    console.log('Saved answer_key_document_id:', jsonData.document_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_documents/05b_separate_answer_key.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["documents", "upload"]
            },
            "description": "Uploads separate official answer key document."
          }
        },
        {
          "name": "2.4 Check Processing Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "status"]
            },
            "description": "Polls background extraction status and progress."
          }
        },
        {
          "name": "2.5 List All Documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Lists all documents uploaded by user with pagination."
          }
        }
      ]
    },
    {
      "name": "3. Questions & Extraction Results",
      "item": [
        {
          "name": "3.1 List Extracted Questions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.questions && jsonData.questions.length > 0) {",
                  "    pm.collectionVariables.set('question_id', jsonData.questions[0].id);",
                  "    pm.environment.set('question_id', jsonData.questions[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/questions",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "questions"]
            },
            "description": "Fetches all extracted questions, options, confidence scores, and source pages."
          }
        },
        {
          "name": "3.2 Get Single Question Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/questions/{{question_id}}",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "questions", "{{question_id}}"]
            },
            "description": "Retrieves deep details and traceability snippet for a specific question."
          }
        },
        {
          "name": "3.3 Get Document Answers Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/answers",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "answers"]
            },
            "description": "Summarizes extracted answers, matching confidence, and answered counts."
          }
        },
        {
          "name": "3.4 Get Human Review Items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/review-items",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "review-items"]
            },
            "description": "Lists flagged extraction anomalies (low confidence, OCR errors, multi-page spans)."
          }
        }
      ]
    },
    {
      "name": "4. Multi-Document Relationships",
      "item": [
        {
          "name": "4.1 Link Separate Answer Key Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"related_document_id\": \"{{answer_key_document_id}}\",\n  \"relationship_type\": \"ANSWER_KEY\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/relationships",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "relationships"]
            },
            "description": "Associates an external Answer Key document with the Question Paper, populating answers automatically."
          }
        },
        {
          "name": "4.2 List Document Relationships",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/relationships",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "relationships"]
            },
            "description": "Lists all relationships for the current document."
          }
        }
      ]
    },
    {
      "name": "5. Negative & Error Handling Tests",
      "item": [
        {
          "name": "5.1 Reject Unsupported File Format (.txt)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_documents/06_invalid_format.txt"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["documents", "upload"]
            },
            "description": "Verifies that non-PDF and non-image files are rejected with HTTP 400."
          }
        },
        {
          "name": "5.2 Reject Corrupted PDF Header",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_documents/07_corrupted_file.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["documents", "upload"]
            },
            "description": "Verifies that spoofed/malformed files failing magic-byte checks are rejected."
          }
        }
      ]
    }
  ]
}
