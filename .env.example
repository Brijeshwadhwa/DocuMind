# Environment Configuration for DocuMind

# Application
APP_NAME="DocuMind"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generated secure random secret for JWT encoding/decoding
SECRET_KEY=change_this_to_a_super_secret_key_in_production_minimum_32_chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Use PostgreSQL in Docker / Production: postgresql+psycopg2://postgres:postgres@localhost:5432/document_intelligence
# Can fallback to SQLite for local development: sqlite:///./document_intelligence.db
DATABASE_URL=sqlite:///./document_intelligence.db

# Redis & Celery
# In Docker: redis://redis:6379/0
# In Local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Set to True to run Celery tasks synchronously (in-process), ideal for local dev/testing without active Redis daemon
CELERY_TASK_ALWAYS_EAGER=True

# File Upload & Storage
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# OCR Settings
# Path to local Tesseract binary if not on PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe or /usr/bin/tesseract)
TESSERACT_CMD=tesseract
OCR_FALLBACK_ENABLED=True
OCR_DPI=300

# Optional External AI/OCR Service (disabled by default, fallback to local pipeline)
EXTERNAL_AI_ENABLED=False
EXTERNAL_AI_PROVIDER=none
EXTERNAL_AI_API_KEY=
